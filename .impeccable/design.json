  "narrative": {
    "northStar": "The itops.dev Terminal",
    "overview": "The site extends the existing itops.dev terminal identity into a public skill directory. Black is the continuous canvas; vivid green identifies headings, links, primary actions, and the small cursor. Courier New gives navigation, controls, and long instructions one consistent voice.\n\nThe presentation is flat and text-led. Quiet green-tinted text and thin dividers support dense reading; the bright accent marks useful actions. The system uses the homepage identity specified in PRODUCT.md and the implementation in web/style.css, web/app.js, and src/render.mjs. This document records that implementation, not a new brand direction.",
    "keyCharacteristics": [
      "One monospaced family throughout.",
      "Black canvas with terminal-green action and heading accents.",
      "Square controls, thin dividers, and open directory rows.",
      "Responsive reading columns and explicit source metadata.",
      "One cursor animation, with a reduced-motion alternative."
    ],
    "rules": [
      {
        "name": "The Terminal Accent Rule",
        "body": "Use terminal green for headings, links, actions, selection, and keyboard focus. Use the quieter ink and muted colors for sustained reading and supporting metadata.",
        "section": "colors"
      },
      {
        "name": "The Single Voice Rule",
        "body": "Keep the Courier New stack across headings, body text, controls, and code. Distinguish hierarchy through size, weight, spacing, and color.",
        "section": "typography"
      },
      {
        "name": "The Flat Reading Rule",
        "body": "Separate content with spacing, thin lines, and green-tinted surfaces. Keep the faint catalog-heading glow out of long-form reading and controls.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the inherited black, green, Courier, square-control, and cursor identity.",
      "Do keep titles and descriptions ahead of technical metadata in directory rows.",
      "Do use visible keyboard focus, readable text contrast, and the existing reduced-motion treatment.",
      "Do keep source instructions readable and provide the manual-copy fallback when clipboard access fails.",
      "Do preserve the mobile stacking, full-width primary actions, and wrapping of long source identifiers."
    ],
    "donts": [
      "Don't introduce rounded cards, gradients, or raised box shadows into this flat terminal system.",
      "Don't extend the heading glow to paragraphs, metadata, or controls.",
      "Don't add more animated decoration around the single cursor motif.",
      "Don't treat the sidecar's illustrative tonal ramps as extra production colors."
    ]
  }
}
